ENVIRONMENT=local
DEBUG=true

SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

BACKEND_CORS_ORIGINS=["http://localhost:3000"]

POSTGRES_USER=deutschai
POSTGRES_PASSWORD=deutschai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=deutschai

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=grammar_knowledge_base

# Required for the Tutor, Conversation, and Writing Agents to actually
# generate/grade (see docs/FEATURES.md). Leave unset to run everything else;
# those three endpoints return a clear 503 until a provider is configured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Free alternative to a paid Claude key: point at a local Ollama server (or
# any OpenAI-compatible endpoint) instead. Run Ollama (https://ollama.com),
# `ollama pull llama3.2`, then set:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2
# LLM_API_KEY is only needed for a real (non-local) OpenAI-compatible provider.
LLM_PROVIDER=anthropic
LLM_MODEL=llama3.2
LLM_API_KEY=
LLM_BASE_URL=

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=deutschai
MINIO_SECRET_KEY=deutschai123
MINIO_BUCKET=deutschai-media

# Speech engine — both run locally, no API key needed.
WHISPER_MODEL_SIZE=base
PIPER_VOICE=de_DE-thorsten-medium

# Observability, both optional. Leave unset to run everything else;
# Sentry capture / OpenTelemetry tracing are simply not initialized until set.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=deutschai-backend
