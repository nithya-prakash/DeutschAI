ENVIRONMENT=local
DEBUG=true

SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

BACKEND_CORS_ORIGINS=["http://localhost:3000"]

POSTGRES_USER=deutschai
POSTGRES_PASSWORD=deutschai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=deutschai

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=grammar_knowledge_base

# Required for the Tutor Agent to actually generate answers (see docs/ROADMAP.md).
# Leave unset to run everything else; /tutor/ask will return a clear 503 until set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=deutschai
MINIO_SECRET_KEY=deutschai123
MINIO_BUCKET=deutschai-media

# Speech engine (Phase 4) — both run locally, no API key needed.
WHISPER_MODEL_SIZE=base
PIPER_VOICE=de_DE-thorsten-medium
