# Copy to .env and adjust before running `docker compose up`.
# docker-compose.yml reads these to configure every service; the backend
# also reads its own app/.env.example if you run it outside Docker.

ENVIRONMENT=local
DEBUG=true

# Generate a real secret for anything beyond local dev: `openssl rand -hex 32`
SECRET_KEY=dev-only-change-me-in-production-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

POSTGRES_USER=deutschai
POSTGRES_PASSWORD=deutschai
POSTGRES_DB=deutschai

MINIO_ACCESS_KEY=deutschai
MINIO_SECRET_KEY=deutschai123

# Required for the Tutor, Conversation, and Writing Agents (see
# docs/FEATURES.md) — everything else in the app works without it. Leave
# blank to run the rest of the stack.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Free alternative to a paid Claude key: point at a local Ollama server (or
# any OpenAI-compatible endpoint) instead. Run Ollama on the host
# (https://ollama.com), `ollama pull llama3.2`, then set:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=llama3.2
# (host.docker.internal, not localhost — the backend runs inside Docker.)
# LLM_API_KEY is only needed for a real (non-local) OpenAI-compatible provider.
LLM_PROVIDER=anthropic
LLM_MODEL=llama3.2
LLM_API_KEY=
LLM_BASE_URL=

# Optional observability — leave blank to run everything else;
# Sentry capture / OpenTelemetry tracing are simply not initialized until set.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
