# Copy to .env and adjust before running `docker compose up`.
# docker-compose.yml reads these to configure every service; the backend
# also reads its own app/.env.example if you run it outside Docker.

ENVIRONMENT=local
DEBUG=true

# Generate a real secret for anything beyond local dev: `openssl rand -hex 32`
SECRET_KEY=dev-only-change-me-in-production-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

POSTGRES_USER=deutschai
POSTGRES_PASSWORD=deutschai
POSTGRES_DB=deutschai

MINIO_ACCESS_KEY=deutschai
MINIO_SECRET_KEY=deutschai123

# Required for the Tutor Agent (see docs/ROADMAP.md) — everything else in the
# app works without it. Leave blank to run the rest of the stack.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional observability (Phase 6) — leave blank to run everything else;
# Sentry capture / OpenTelemetry tracing are simply not initialized until set.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
